NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=https://www.pacificplainselectric.com
# Server-only; never use NEXT_PUBLIC_ for privileged credentials.
SUPABASE_SECRET_KEY=
# Owner email for new website requests (https://resend.com). Server-only.
# FROM must use a domain verified in Resend, e.g. "Pacific Plains Electric <requests@pacificplainselectric.com>".
RESEND_API_KEY=
REQUEST_EMAIL_FROM=
# Optional; defaults to the business email in config/business.ts.
REQUEST_EMAIL_TO=
VOLTEIRA_MODE=unavailable
VOLTEIRA_API_URL=
VOLTEIRA_API_KEY=
VOLTEIRA_WEBHOOK_SECRET=
# Set only after a reviewed adapter is implemented against the real Volteira contract.
VOLTEIRA_ADAPTER_READY=false
# Optional verified Volteira management origin.
VOLTEIRA_ADMIN_URL=https://www.volteira.com
